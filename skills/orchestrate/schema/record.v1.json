{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cekrauseee/harness/schema/record.v1.json",
  "title": "HarnessRunRecord",
  "description": "Run record (harness-record-v1), written once at delivery by the agent that did the work, at work/<work>/fronts/<front>/runs/<run>.record.json. Contract: docs/records.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "work", "front", "run", "kind", "base", "head", "changed", "summary", "owned", "cards", "files", "notes", "attention", "flows", "tests", "followups"],
  "properties": {
    "format": {"const": "harness-record-v1"},
    "work": {"$ref": "#/$defs/slug"},
    "front": {"$ref": "#/$defs/slug"},
    "run": {"$ref": "#/$defs/slug", "description": "Unique within the front; one record per iteration."},
    "kind": {"enum": ["implement", "test", "review"]},
    "iteration": {"type": "integer", "minimum": 1},
    "host": {"type": "string", "maxLength": 80},
    "model": {"type": "string", "maxLength": 120},
    "session": {"type": "string", "maxLength": 200},
    "base": {"$ref": "#/$defs/sha"},
    "head": {"$ref": "#/$defs/sha"},
    "changed": {"type": "array", "description": "Paths changed in base...head, as Git lists them.", "items": {"$ref": "#/$defs/path"}},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "modules": {"type": "array", "items": {"type": "string", "maxLength": 200}},
    "owned": {"type": "array", "description": "Attention point and flow ids assigned to this run; each needs an entry in attention or flows.", "items": {"$ref": "#/$defs/ownedId"}},
    "cards": {"type": "array", "items": {"$ref": "#/$defs/card"}},
    "files": {"type": "object", "description": "Role of each changed path this run is responsible for.", "additionalProperties": {"$ref": "#/$defs/text"}},
    "notes": {"type": "array", "description": "Notes for significant symbols only; other hunks fall back to the commit message.", "items": {"$ref": "#/$defs/note"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "attention": {"type": "array", "items": {"$ref": "#/$defs/attention"}},
    "flows": {"type": "array", "description": "User-visible reproduction, only when the run makes behavior visible.", "items": {"$ref": "#/$defs/flow"}},
    "tests": {"type": "array", "items": {"$ref": "#/$defs/test"}},
    "followups": {"type": "array", "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 80},
    "ownedId": {"type": "string", "pattern": "^(ap|fl)-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "symbol": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Top-level declaration name, or Outer.inner for a nested one."},
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer", "title", "summary", "files"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "layer": {"$ref": "#/$defs/id"},
        "group": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"$ref": "#/$defs/text"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "symbol", "text"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "symbol": {"$ref": "#/$defs/symbol"}, "text": {"$ref": "#/$defs/text"}}
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {"from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "label": {"type": "string", "maxLength": 200}}
    },
    "codeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "symbol": {"$ref": "#/$defs/symbol"}, "note": {"$ref": "#/$defs/text"}}
    },
    "testRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "title"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "title": {"type": "string", "minLength": 1, "maxLength": 500, "description": "Exact test title as written in the file at head."}}
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^ap-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "status": {"enum": ["handled", "partial", "open"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "handling": {"$ref": "#/$defs/text"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/codeRef"}},
        "tests": {"type": "array", "items": {"$ref": "#/$defs/testRef"}},
        "qa": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "residual": {"$ref": "#/$defs/text"},
        "cards": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "steps"],
      "properties": {
        "id": {"type": "string", "pattern": "^fl-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "actor": {"type": "string", "maxLength": 80},
        "cards": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "test": {"$ref": "#/$defs/testRef"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "do", "expect"],
      "properties": {
        "actor": {"type": "string", "minLength": 1, "maxLength": 80},
        "title": {"type": "string", "maxLength": 200},
        "do": {"$ref": "#/$defs/text"},
        "expect": {"$ref": "#/$defs/text"},
        "url": {"type": "string", "pattern": "^(/|https?://(localhost|127\\.0\\.0\\.1|\\[::1\\])([:/]|$))", "description": "App path or local URL."},
        "commands": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
        "cards": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "code": {"type": "array", "items": {"$ref": "#/$defs/codeRef"}},
        "test": {"$ref": "#/$defs/testRef"}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "title", "ids"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "ids": {"type": "array", "items": {"$ref": "#/$defs/ownedId"}}
      }
    }
  }
}
