{
  "name": "harness-map-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "tsc -b && vite build",
    "preview": "node scripts/serve.mjs preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
