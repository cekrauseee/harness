{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/skills/harness-init/scripts/hook_adapter.py\" event session-start",
            "timeout": 15,
            "statusMessage": "Loading Harness context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/skills/harness-init/scripts/hook_adapter.py\" event user-prompt",
            "timeout": 15,
            "statusMessage": "Loading task-specific Harness context"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/skills/harness-init/scripts/hook_adapter.py\" event pre-compact",
            "timeout": 15,
            "statusMessage": "Checkpointing Harness context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/skills/harness-init/scripts/hook_adapter.py\" event stop",
            "timeout": 15,
            "statusMessage": "Updating Harness continuity"
          }
        ]
      }
    ]
  }
}
